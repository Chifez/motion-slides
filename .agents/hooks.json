{
  "adr-compliance-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx .agents/scripts/verify-adr.ts",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
