{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@motionslides/shared": ["packages/shared/src/index.ts"]
    },
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "apps/web/src/**/*",
    "packages/shared/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".output",
    "apps/web/dist",
    "apps/web/.output"
  ]
}

