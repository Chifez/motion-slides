PORT=3001
FRONTEND_URL=http://localhost:3000

# Export & Puppeteer
EXPORT_TIMEOUT_MS=300000
MAX_CONCURRENT=2
CHROME_EXECUTABLE=path_to_chrome_headless_shell_executable

# Admin Panel Auth
ADMIN_USER=admin
ADMIN_PASS=your_secure_password_here

# Queue & Storage
REDIS_URL=redis://127.0.0.1:6379
REDIS_REJECT_UNAUTHORIZED=false
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
OUTPUT_DIR=./exports

# Security
ENCRYPTION_KEY=your_encryption_key_here
