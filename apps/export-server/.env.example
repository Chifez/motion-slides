PORT=3001
FRONTEND_URL=http://localhost:3000

# Export & Puppeteer
EXPORT_TIMEOUT_MS=300000
MAX_CONCURRENT=2
CHROME_EXECUTABLE=path_to_chrome_headless_shell_executable

# Admin Panel Auth
ADMIN_USER=admin
ADMIN_PASS=your_secure_password_here

# Queue & Storage
REDIS_URL=redis://127.0.0.1:6379
REDIS_REJECT_UNAUTHORIZED=false

# Storage Provider: 'local', 'r2', or 's3'
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
OUTPUT_DIR=./exports

# Cloudflare R2 / AWS S3 Configuration (for production deployment)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=motionslides-exports
# Optional: custom domain / public bucket URL for direct CDN downloads
R2_PUBLIC_URL=

# Security
ENCRYPTION_KEY=your_encryption_key_here
