VITE_EXPORT_SERVER_URL=http://localhost:3001
DATABASE_URL=postgres://user:password@localhost:5432/motionslides

# AI Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Auth Config
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_auth_secret_here
# Comma-separated list of extra trusted origins for CORS/CSRF (e.g. wildcards, custom domains)
BETTER_AUTH_TRUSTED_ORIGINS=https://motionslides.app,https://*.motionslides.app,https://*.workers.dev
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Private Beta & Early Access Gating
# Set PRIVATE_BETA=true to restrict sign-ups to approved emails. Set to false for open public access.
PRIVATE_BETA=true
ADMIN_EMAILS=chifez1@gmail.com
ALLOWED_EMAILS=

# Storage
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# App Config
VITE_FORCE_TOUR=true
ENCRYPTION_KEY=your_encryption_key_here
