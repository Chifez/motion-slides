VITE_EXPORT_SERVER_URL=http://localhost:3001
DATABASE_URL=postgres://user:password@localhost:5432/motionslides

# AI Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Local LLM endpoint (Ollama daemon for local development)
OLLAMA_BASE_URL=http://localhost:11434/v1
# Production Open-Source Acceleration (Groq high-speed Llama 3.3 / Qwen inference at 350+ tok/s)
GROQ_API_KEY=your_groq_api_key
# Optional: Cloudflare Workers AI edge credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Auth Config
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_auth_secret_here
# Comma-separated list of extra trusted origins for CORS/CSRF (e.g. wildcards, custom domains)
BETTER_AUTH_TRUSTED_ORIGINS=https://motionslides.app,https://*.motionslides.app,https://*.workers.dev
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Email Configuration (Optional - for Password Reset emails)
RESEND_API_KEY=
EMAIL_FROM=MotionSlides <auth@motionslides.app>

# Private Beta & Early Access Gating
# Set PRIVATE_BETA=true to restrict sign-ups to approved emails. Set to false for open public access.
PRIVATE_BETA=true
ADMIN_EMAILS=
ALLOWED_EMAILS=

# Storage
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# App Config
VITE_FORCE_TOUR=false
ENCRYPTION_KEY=your_encryption_key_here
